type Query {
    fetchApi(apiName: String!): DynamicResponse
    listApis: [ApiInfo]
}

type DynamicResponse {
    apiName:     String
    description: String
    totalRows:   Int
    rows:        [DynamicRow]
}

type DynamicRow {
    fields: [Field]
}

type Field {
    key:   String
    value: String
}

# Exposes what APIs are available — useful for consumers to discover
type ApiInfo {
    apiName:     String
    description: String
    sourceTable: String
    columnCount: Int
}